# hallptz-provision.service — privileged setup provisioning (oneshot)
#
# Triggered by hallptz-provision.path when the unprivileged setup wizard writes
# /run/hallptz/request.json. The wrapper runs `python3 -m runtime.provision` first,
# then publishes result.json only after Raspberry Pi runtime finalisation and
# legacy-autostart migration have also completed.

[Unit]
Description=Hall PTZ Control setup provisioning and Raspberry Pi integration
ConditionPathExists=/run/hallptz/request.json
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hallptz
ExecStart=/bin/bash /opt/hallptz/scripts/provision_with_rpi_integration.sh
# First-run integration may install x11-xserver-utils and wait for the desktop
# X11 session on a slow Raspberry Pi. Keep the systemd timeout above the wizard's
# normal filesystem and network latency budget.
TimeoutStartSec=600

Environment=HALLPTZ_DATA_DIR=/var/lib/hallptz
Environment=HALLPTZ_DISPLAY=:0
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/etc/hallptz/install-state.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hallptz-provision
